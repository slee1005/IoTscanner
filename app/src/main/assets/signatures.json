  "wifi_rules": [
    {
      "id": "wifi_direct",
      "category": "wifi_direct",
      "label": "Wi-Fi Direct 그룹",
      "priority": 90,
      "match": {
        "ssid_regex": "^DIRECT-"
      },
      "label_en": "Wi-Fi Direct name match"
    },
    {
      "id": "iphone_hotspot",
      "category": "hotspot",
      "label": "iPhone/iPad 핫스팟",
      "priority": 80,
      "match": {
        "ssid_regex": "(?i)(iphone|ipad)"
      },
      "label_en": "iPhone / iPad hotspot name match"
    },
    {
      "id": "android_hotspot",
      "category": "hotspot",
      "label": "Android 핫스팟",
      "priority": 80,
      "match": {
        "ssid_regex": "(?i)(galaxy|androidap|pixel|redmi|xiaomi|oneplus|hotspot|핫스팟)"
      },
      "label_en": "Android hotspot name match"
    },
    {
      "id": "hidden_random_mac",
      "category": "hotspot",
      "label": "숨김 SSID + 랜덤 MAC (핫스팟 의심)",
      "priority": 70,
      "match": {
        "hidden_ssid": true,
        "locally_administered": true
      },
      "label_en": "Hidden network with local address",
      "risk": "LOW",
      "verify": true
    },
    {
      "id": "random_mac_ap",
      "category": "hotspot",
      "label": "랜덤 MAC AP (핫스팟 가능성, 기업용 AP일 수도 있음)",
      "risk": "LOW",
      "priority": 60,
      "match": {
        "locally_administered": true
      },
      "label_en": "Locally administered access point"
    }
