      "label": "스마트워치/밴드 (이름 기반)",
      "priority": 70,
      "match": {
        "name_regex": "(?i)(watch|band|fitbit|garmin|amazfit|mi ?band)"
      },
      "label_en": "Watch / band name match"
    },
    {
