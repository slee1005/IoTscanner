  "ble_rules": [
    {
      "id": "meta_glasses_service",
      "category": "smart_glasses",
      "label": "Meta 스마트 안경 (Ray-Ban Meta 등)",
      "priority": 100,
      "verify": true,
      "match": {
        "service_uuid": "FD5F"
      },
      "label_en": "Meta glasses service (unverified)"
    },
    {
      "id": "meta_company_01ab",
      "category": "smart_glasses",
      "label": "Meta 기기 (안경 가능성 높음)",
      "priority": 95,
      "verify": true,
      "match": {
        "company_id": "0x01AB"
      },
      "label_en": "Manufacturer 0x01AB (unverified)"
    },
    {
      "id": "meta_company_058e",
      "category": "smart_glasses",
      "label": "Meta Platforms Technologies 기기",
      "priority": 95,
      "verify": true,
      "match": {
        "company_id": "0x058E"
      },
      "label_en": "Manufacturer 0x058E (unverified)"
    },
    {
      "id": "glasses_by_name",
      "category": "smart_glasses",
      "label": "스마트 안경 (이름 기반)",
      "priority": 90,
      "match": {
        "name_regex": "(?i)(ray-?ban|meta.*glass|even ?g1|rokid|xreal|smart ?glass)"
      },
      "label_en": "Smart glasses name match"
    },
    {
      "id": "apple_proximity_pairing",
      "category": "earbuds",
      "label": "AirPods / Beats",
      "priority": 80,
      "match": {
        "company_id": "0x004C",
        "mfg_data_prefix": "07"
      },
      "label_en": "AirPods / Beats packet match"
    },
    {
      "id": "earbuds_by_name",
      "category": "earbuds",
      "label": "무선 이어폰 (이름 기반)",
      "priority": 75,
      "match": {
        "name_regex": "(?i)(airpods|buds|earbud|pods|beats|jabra|bose|wf-|soundcore|qcy)"
      },
      "label_en": "Wireless earbuds name match"
    },
    {
      "id": "watch_by_name",
